generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Hero statistics (editable from admin)
model Statistic {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int
  label     String
  suffix    String?
  icon      String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("statistics")
}

// نموذج المستخدم
model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  name                 String?
  password             String
  role                 Role          @default(USER)
  mustChangePassword   Boolean       @default(false)
  phonePushToken       String?
  phonePlatform        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  projects       Project[]
  services       Service[]
  testimonials   Testimonial[]
  products       Product[]

  @@map("users")
}

// نموذج المشروع (translations: { "ar": { "title", "description", "content" }, ... })
model Project {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String
  content      String?
  translations Json? // { "ar": { "title", "description", "content" }, "en", "ku", "tr" }
  category     String
  tags         String[]
  technologies String[]
  client       String?
  year         Int
  duration     String?
  budget       String?
  featured     Boolean       @default(false)
  status       ProjectStatus @default(COMPLETED)
  imageUrl     String?
  gallery      String[]
  liveUrl      String?
  githubUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// نموذج الخدمة (translations: { "ar": { "title": "", "description": "" }, "en": { ... }, ... })
model Service {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String
  content      String?
  icon         String
  features     String[]
  category     String
  priceRange   String?
  duration     String?
  featured     Boolean       @default(false)
  imageUrl     String?
  translations Json? // { "ar": { "title", "description" }, "en": { ... }, "ku": { ... }, "tr": { ... } }
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testimonials Testimonial[]

  @@map("services")
}

// نموذج العملاء
model Client {
  id          String   @id @default(cuid())
  name        String
  logo        String
  website     String?
  industry    String?
  testimonial String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("clients")
}

// نموذج الشهادات
model Testimonial {
  id        String   @id @default(cuid())
  content   String
  author    String
  position  String
  company   String?
  rating    Int      @default(5)
  imageUrl  String?
  featured  Boolean  @default(false)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

// نموذج الوظائف (translations: { "ar": { "title", "description" }, "en", "ku", "tr" })
model Career {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String
  translations Json?
  requirements String[]
  benefits     String[]
  department   String
  location     String
  jobType      JobType
  experience   String
  salaryRange  String?
  remote       Boolean       @default(false)
  featured     Boolean       @default(false)
  status       JobStatus     @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@map("careers")
}

// نموذج التقديم على الوظائف
model Application {
  id          String            @id @default(cuid())
  name        String
  email       String
  phone       String
  coverLetter String?
  resumeUrl   String
  status      ApplicationStatus @default(PENDING)
  careerId    String
  career      Career            @relation(fields: [careerId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("applications")
}

// نموذج جهات الاتصال
model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contacts")
}

// نموذج الاشتراك في النشرة البريدية
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscribers")
}

// Teams (technical & engineers) for ticket assignment
model Team {
  id        String           @id @default(cuid())
  name      String
  leaderId  String
  leader    Employee         @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  tickets   VisitorRequest[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("teams")
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       String // TECHNICAL | ENGINEER
  createdAt  DateTime @default(now())

  @@unique([teamId, employeeId])
  @@map("team_members")
}

// طلبات الزوار (Smart Home Automation / Programming)
model VisitorRequest {
  id                             String                   @id @default(cuid())
  buildingType                   String? // home, villa, hotel, complex, other (null for programming)
  phone                          String
  province                       String
  technique                      String // knx, buspro, zigbee | maintenance, fiber, etc.
  name                           String?
  company                        String?
  email                          String?
  serviceSlug                    String                   @default("smart-home-automation")
  // Enterprise networking ticket fields
  siteName                       String?
  siteCoordinator                String?
  slaHours                       Int?
  currentAmps                    Float? // clean-energy: required current (A)
  kwh                            Float? // clean-energy: required kWh capacity
  status                         TicketStatus             @default(PENDING)
  completedAt                    DateTime?
  taskCategory                   ProviderTaskCategory?
  roleScope                      ProviderRoleScope?       @default(ANY)
  workflowState                  ProviderWorkflowState    @default(OPEN)
  assignmentScope                ProviderAssignmentScope?
  checklistTemplateId            String?
  privateCompanyId               String?
  privateCompany                 PrivateCompany?          @relation("PrivateCompanyScopedTickets", fields: [privateCompanyId], references: [id], onDelete: SetNull)
  /// When set, workspace pool visibility is limited to this department (plus assignee/crew). Null = all departments (still filtered by technique matrix + province).
  privateCompanyTargetDepartmentId String?
  privateCompanyTargetDepartment   PrivateCompanyDepartment? @relation("WorkspaceTicketTargetDepartment", fields: [privateCompanyTargetDepartmentId], references: [id], onDelete: SetNull)
  coordinatorCompanyId           String?
  coordinatorCompany             CoordinatorCompany?      @relation(fields: [coordinatorCompanyId], references: [id], onDelete: SetNull)
  createdByCoordinatorUserId     String?
  createdByCoordinatorUser       CoordinatorUser?         @relation("ProviderTicketCreatedBy", fields: [createdByCoordinatorUserId], references: [id], onDelete: SetNull)
  assigneeCoordinatorUserId      String?
  assigneeCoordinatorUser        CoordinatorUser?         @relation("ProviderTicketAssignee", fields: [assigneeCoordinatorUserId], references: [id], onDelete: SetNull)
  resubmittedByCoordinatorUserId String?
  resubmittedByCoordinatorUser   CoordinatorUser?         @relation("ProviderTicketResubmittedBy", fields: [resubmittedByCoordinatorUserId], references: [id], onDelete: SetNull)
  resubmitReason                 String?
  resubmittedAt                  DateTime?
  assignedTeamId                 String?
  assignedTeam                   Team?                    @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  assignedAt                     DateTime?
  maintenanceDescription         String? // description of maintenance work done (when completed)
  beforeImageUrls                Json? // before images (when IN_PROGRESS+)
  finishingImageUrls             Json? // after / finishing site photos
  checklistResponse              Json? // { checklistId, checklistName, items: [{id, label, checked, note?}], completedAt }
  requesterId                    String?
  requester                      TicketRequester?         @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  specializationTags             String[]                 @default([])
  statusLogs                     TicketStatusLog[]
  comments                       TicketComment[]
  evidence                       TicketEvidence[]
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  CoordinatorTicketCharge        CoordinatorTicketCharge?

  // ── Private company warehouse (materials consumed on this ticket) ────
  usedMaterialItems              PrivateCompanyMaterialItem[]     @relation("PrivateCompanyMaterialItemUsedTicket")
  materialMovements              PrivateCompanyMaterialMovement[] @relation("PrivateCompanyMaterialMovementTicket")

  @@index([privateCompanyTargetDepartmentId])
  @@map("visitor_requests")
}

// Timeline of status changes for each ticket (dashboard)
model TicketStatusLog {
  id               String         @id @default(cuid())
  visitorRequestId String
  visitorRequest   VisitorRequest @relation(fields: [visitorRequestId], references: [id], onDelete: Cascade)
  status           TicketStatus
  createdAt        DateTime       @default(now())

  @@index([visitorRequestId])
  @@map("ticket_status_logs")
}

model TicketComment {
  id               String         @id @default(cuid())
  visitorRequestId String
  visitorRequest   VisitorRequest @relation(fields: [visitorRequestId], references: [id], onDelete: Cascade)
  authorId         String
  authorName       String
  body             String
  createdAt        DateTime       @default(now())

  @@index([visitorRequestId])
  @@map("ticket_comments")
}

model TicketEvidence {
  id               String         @id @default(cuid())
  visitorRequestId String
  visitorRequest   VisitorRequest @relation(fields: [visitorRequestId], references: [id], onDelete: Cascade)
  uploadedById     String
  uploadedByName   String
  fileUrl          String
  fileType         String // image | pdf
  description      String?
  createdAt        DateTime       @default(now())

  @@index([visitorRequestId])
  @@map("ticket_evidence")
}

// Ticket requester accounts (each linked to one service: enterprise-networking OR quality-control-supervision)
model TicketRequester {
  id                      String           @id @default(cuid())
  username                String           @unique
  passwordHash            String
  name                    String?
  email                   String?          @unique
  phone                   String
  company                 String?
  companyCertificationUrl String? // uploaded file path/URL
  specialization          RequesterSpecialization?
  verificationStatus      RequesterVerificationStatus @default(PENDING)
  verificationRejectedReason String?
  verifiedAt              DateTime?
  serviceSlug             String           @default("enterprise-networking") // which dashboard: enterprise-networking | quality-control-supervision
  role                    RequesterRole    @default(COMPANY)
  province                String?
  provinceFilterActive    Boolean          @default(true)
  status                  RequesterStatus  @default(ACTIVE)
  hasUpdatedCredentials   Boolean          @default(false)
  mustChangePassword      Boolean          @default(false)
  phonePushToken          String?
  phonePlatform           String?
  preferredLocale         String? // en | ar | tr | ku (Provisor UI language)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  tickets                 VisitorRequest[]
  sites                   Site[]
  siteSharesReceived      SiteShare[]      @relation("SiteShareRecipient")
  companyProfile          Company? // when created from company request

  // ── Private company workspace (mobile-first feature) ──────────────────
  /// The workspace this requester owns (set when this is the COMPANY-role owner of the workspace).
  privateCompanyOwned        PrivateCompany?           @relation("PrivateCompanyOwner")
  /// Workspace the requester belongs to as staff member.
  privateCompanyId           String?
  privateCompany             PrivateCompany?           @relation("PrivateCompanyStaff", fields: [privateCompanyId], references: [id], onDelete: SetNull)
  privateCompanyDepartmentId String?
  privateCompanyDepartment   PrivateCompanyDepartment? @relation("PrivateCompanyDepartmentMember", fields: [privateCompanyDepartmentId], references: [id], onDelete: SetNull)
  /// Optional allowlist of workspace ticket technique slugs; empty = inherit department/workspace technique catalog only.
  privateCompanyAllowedTaskSlugs String[] @default([])
  /// When set, overrides department defaults for maintenance proximity teaming.
  maintenanceProximityJoinOverride   Boolean?
  maintenanceProximityRadiusOverrideM Int?
  /// Created checklists inside their workspace.
  privateCompanyChecklistsCreated PrivateCompanyChecklist[] @relation("PrivateCompanyChecklistCreator")

  // ── Private company warehouse ─────────────────────────────────────────
  assignedMaterialItems          PrivateCompanyMaterialItem[]     @relation("PrivateCompanyMaterialItemAssignee")
  materialMovementsFrom          PrivateCompanyMaterialMovement[] @relation("PrivateCompanyMaterialMovementFrom")
  materialMovementsTo            PrivateCompanyMaterialMovement[] @relation("PrivateCompanyMaterialMovementTo")
  materialMovementsActed         PrivateCompanyMaterialMovement[] @relation("PrivateCompanyMaterialMovementActor")
  materialsCreated               PrivateCompanyMaterial[]         @relation("PrivateCompanyMaterialCreator")
  materialItemsStocked           PrivateCompanyMaterialItem[]     @relation("PrivateCompanyMaterialItemStocker")
  materialRequestsSubmitted      PrivateCompanyMaterialRequest[]  @relation("MaterialRequestRequester")
  materialRequestsResponded      PrivateCompanyMaterialRequest[]  @relation("MaterialRequestResponder")
  materialStaffBudgets           PrivateCompanyStaffMaterialBudget[] @relation("StaffMaterialBudget")
  materialHandoversConfirmed     PrivateCompanyMaterialItem[]        @relation("MaterialHandoverConfirmedBy")
  materialReturnRequests         PrivateCompanyMaterialItem[]        @relation("MaterialReturnRequestedBy")

  @@map("ticket_requesters")
}

// Company dashboard request (from service page: enterprise-networking OR quality-control-supervision)
model CompanyRequest {
  id             String               @id @default(cuid())
  companyName    String
  pocName        String // Point of Contact name
  pocEmail       String? // POC email (verified via 2FA before request)
  pocPhone       String
  certificateUrl String? // optional company certificate/license
  serviceSlug    String               @default("enterprise-networking") // which dashboard to create
  status         CompanyRequestStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("company_requests")
}

// Email OTP for dashboard registration 2FA (verify real email)
model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
  @@map("email_otps")
}

enum CompanyRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Registration request from login page (company or engineer role)
model RegistrationRequest {
  id           String                    @id @default(cuid())
  legalName    String
  phone        String
  email        String
  province     String // Iraq province
  evidenceUrl  String // identification document (ID, passport, etc.)
  specialization RequesterSpecialization?
  rejectionReason String?
  username     String?
  passwordHash String?
  role         RequesterRole // COMPANY, ENGINEER, TECHNICIAN, or PERSONAL
  status       RegistrationRequestStatus @default(PENDING)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@map("registration_requests")
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Approved company (linked to a dashboard account for one service type)
model Company {
  id             String          @id @default(cuid())
  companyName    String
  pocName        String
  pocPhone       String
  certificateUrl String?
  serviceSlug    String          @default("enterprise-networking") // enterprise-networking | quality-control-supervision
  status         CompanyStatus   @default(ACTIVE)
  requesterId    String          @unique
  requester      TicketRequester @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("companies")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

// Sites managed by requesters (for quick ticket creation)
model Site {
  id          String          @id @default(cuid())
  siteId      String // user-defined site identifier
  location    String // site location/address
  province    String // province in Iraq
  latitude    Float?
  longitude   Float?
  requesterId String
  requester   TicketRequester @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  shares      SiteShare[]
  visitorLinks SiteVisitorLink[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([requesterId, siteId])
  @@index([requesterId])
  @@map("sites")
}

/// Another requester granted read access to this site row and related tickets for that owner's site identifier.
model SiteShare {
  id                    String          @id @default(cuid())
  siteId                String
  site                  Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sharedWithRequesterId String
  sharedWith            TicketRequester @relation("SiteShareRecipient", fields: [sharedWithRequesterId], references: [id], onDelete: Cascade)
  /// When false, recipient sees the site location card only — shared ticket OR-clauses are not applied.
  includeTickets        Boolean         @default(true)
  createdAt             DateTime        @default(now())

  @@unique([siteId, sharedWithRequesterId])
  @@index([sharedWithRequesterId])
  @@map("site_shares")
}

/// Time-bound public visitor link for read-only site summary (share by URL).
model SiteVisitorLink {
  id                   String    @id @default(cuid())
  siteId               String
  site                 Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  token                String    @unique
  createdByRequesterId String
  validFrom            DateTime  @default(now())
  validUntil           DateTime
  includeTickets       Boolean   @default(false)
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())

  @@index([siteId])
  @@map("site_visitor_links")
}

enum RequesterStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum RequesterRole {
  COMPANY
  ENGINEER
  TECHNICIAN
  PERSONAL
  WORKER
  // Roles below are used by the private-company workspace feature (mobile app)
  MANAGER
  COORDINATOR
  WAREHOUSE_KEEPER // private workspace: sole role that can mutate warehouse stock
}

enum RequesterSpecialization {
  ELECTRICAL
  MECHANICAL
  CIVIL
  TELECOM
  PROGRAMMER
}

enum RequesterVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  PENDING
  ON_SITE
  IN_PROGRESS
  COMPLETED
}

// Phone OTP for ticket submission (visitors)
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
  @@map("phone_otps")
}

// Notifications: new ticket (admin), status changed (requester)
model Notification {
  id          String   @id @default(cuid())
  type        String // 'new_ticket' | 'status_changed'
  title       String
  message     String
  payload     Json? // { key, vars } for localized title/message at read time and for FCM
  ticketId    String?
  requesterId String?
  forAdmin    Boolean  @default(false)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("notifications")
}

// Employees (admin-managed: technicians, engineers, etc.)
model Employee {
  id              String              @id @default(cuid())
  fullName        String
  phone           String
  jobTitle        String?
  department      String // service title (from services dropdown)
  grade           EmployeeGrade
  education       String?
  specialized     EmployeeSpecialized
  ledTeams        Team[]              @relation("TeamLeader")
  teamMemberships TeamMember[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("employees")
}

enum EmployeeGrade {
  TECHNICIAN_C
  TECHNICIAN_B
  TECHNICIAN_A
  ENGINEER
  SUPERVISOR
  TEAM_LEADER
  SECTION_HEAD
  MANAGER
}

enum EmployeeSpecialized {
  ELECTRICAL_TECHNICIAN
  TELECOM_TECHNICIAN
  FIBER_TECHNICIAN
  ENGINEER
}

// الأنواع المحددة
enum Role {
  ADMIN
  EDITOR
  USER
  TECHNICAL
  ENGINEER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

// Inspection checklist templates (admin-generated, used in QC tickets)
model InspectionChecklist {
  id                     String                @id @default(cuid())
  name                   String // e.g. "Site Safety Inspection"
  items                  Json // [{ "id": "uuid", "label": "Item 1" }, ...]
  companyId              String?
  company                  CoordinatorCompany?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskCategory             ProviderTaskCategory?
  techniqueTypes           String[]              @default([])
  /// When true, hidden from default template pickers; engineer can unarchive for reuse.
  archived                 Boolean               @default(false)
  /// TicketRequester id when an ENGINEER created this template from the field app.
  createdByRequesterId     String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([createdByRequesterId])
  @@index([archived])
  @@map("inspection_checklists")
}

model CoordinatorTicketCharge {
  id        String             @id @default(cuid())
  companyId String
  company   CoordinatorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticketId  String             @unique
  ticket    VisitorRequest     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  plan      TicketBillingPlan
  rateUsd   Float
  amountUsd Float
  billedAt  DateTime           @default(now())
  createdAt DateTime           @default(now())

  @@index([companyId, billedAt])
  @@map("coordinator_ticket_charges")
}

// QC / maintenance technique options (admin-managed; slug is stored on VisitorRequest.technique)
model ProvisorTechnique {
  id        String   @id @default(cuid())
  category  String // INSPECTION_QC | MAINTENANCE
  slug      String
  labelAr   String
  labelEn   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, slug])
  @@map("provisor_techniques")
}

// Training requests (from Explore Training page)
model TrainingRequest {
  id             String                @id @default(cuid())
  serviceSlug    String
  serviceTitle   String
  serviceDesc    String? // brief description
  requesterName  String
  requesterEmail String
  requesterPhone String
  company        String?
  message        String?
  budget         String? // optional budget/notes
  status         TrainingRequestStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status])
  @@map("training_requests")
}

enum TrainingRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// CV builder: one row per PDF export (download) for admin count
model CvExport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  @@map("cv_exports")
}

// Products (KNX, Buspro, Zigbee) – posted from admin, no price, order button only
model Product {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  description    String
  specifications Json? // { "key": "value" } or array of specs
  userManualUrl  String? // PDF or doc URL
  imageUrls      String[]         @default([])
  productType    ProductType // KNX | Buspro | Zigbee
  featured       Boolean          @default(false)
  translations   Json? // { "ar": { "title", "description", "specifications" }, ... }
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests       ProductRequest[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([productType])
  @@index([featured])
  @@map("products")
}

enum ProductType {
  KNX
  Buspro
  Zigbee
}

// Product order requests (from Order button on product detail)
model ProductRequest {
  id           String               @id @default(cuid())
  productId    String
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSlug  String
  productTitle String
  productType  ProductType
  name         String
  email        String
  phone        String
  message      String?
  status       ProductRequestStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([productId])
  @@index([status])
  @@map("product_requests")
}

enum ProductRequestStatus {
  PENDING
  CONTACTED
  QUOTED
  CLOSED
}

// ═══════════════════════════════════════════════════════════════════════════
// U-Smart Digital Project Coordinator Platform (multi-tenant SaaS)
// ═══════════════════════════════════════════════════════════════════════════

enum CoordinatorRole {
  ADMIN
  COMPANY_OWNER
  COORDINATOR
  ENGINEER
  QUALITY_ENGINEER
  SUPERVISION_ENGINEER
  TECHNICIAN
  CLIENT
}

enum CoordinatorUserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum ProviderTaskCategory {
  MAINTENANCE
  QUALITY
  SUPERVISION
}

enum ProviderRoleScope {
  ANY
  QUALITY_ENGINEER
  SUPERVISION_ENGINEER
  TECHNICIAN
}

enum ProviderWorkflowState {
  OPEN
  IN_PROGRESS
  NEEDS_EDIT
  RESUBMITTED
  DONE
}

enum ProviderAssignmentScope {
  COMPANY_STAFF
  USMART_STAFF
  PRIVATE_COMPANY_STAFF
}

enum TicketBillingPlan {
  WEEKLY
  MONTHLY
  YEARLY
}

enum CoordinatorTaskStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  ARCHIVED
}

enum ExternalSystemType {
  API
  PLAYWRIGHT
  OAUTH2
}

enum KPIStatus {
  ON_TRACK
  AT_RISK
  FAILED
}

enum SubscriptionPlanTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum VoiceCallDirection {
  INCOMING
  OUTGOING
}

model CoordinatorCompany {
  id                    String                            @id @default(cuid())
  name                  String
  slug                  String                            @unique
  stripeCustomerId      String?
  subscriptionPlanId    String?
  subscriptionPlan      CoordinatorSubscriptionPlan?      @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  subscriptions         CoordinatorSubscription[]
  users                 CoordinatorUser[]
  contacts              CoordinatorContact[]
  tasks                 CoordinatorTask[]
  kpis                  CoordinatorKPI[]
  reports               CoordinatorReport[]
  externalSystems       CoordinatorExternalSystem[]
  socialAccounts        CoordinatorSocialAccount[]
  jobDutyTemplates      CoordinatorJobDutyTemplate[]
  jobResults            CoordinatorJobResult[]
  generatedApplications CoordinatorGeneratedApplication[]
  auditLogs             CoordinatorAuditLog[]
  voiceCallRecords      CoordinatorVoiceCallRecord[]
  providerTickets       VisitorRequest[]
  inspectionChecklists  InspectionChecklist[]
  ticketCharges         CoordinatorTicketCharge[]
  freeTicketsUsed       Int                               @default(0)
  freeTicketsLimit      Int                               @default(50)
  activeTicketPlan      TicketBillingPlan?
  ticketPlanActivatedAt DateTime?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt

  @@map("coordinator_companies")
}

model CoordinatorUser {
  id                         String                @id @default(cuid())
  username                   String                @unique
  email                      String
  name                       String?
  passwordHash               String
  role                       CoordinatorRole       @default(COORDINATOR)
  status                     CoordinatorUserStatus @default(ACTIVE)
  mustChangePassword         Boolean               @default(false)
  phonePushToken             String?
  phonePlatform              String?
  preferredLocale            String? // en | ar | tr | ku (Provisor UI language)
  companyId                  String
  company                    CoordinatorCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managedByUserId            String?
  managedByUser              CoordinatorUser?      @relation("CoordinatorManager", fields: [managedByUserId], references: [id], onDelete: SetNull)
  managedUsers               CoordinatorUser[]     @relation("CoordinatorManager")
  profile                    CoordinatorProfile?
  tasksCreated               CoordinatorTask[]     @relation("TaskCreator")
  providerTicketsCreated     VisitorRequest[]      @relation("ProviderTicketCreatedBy")
  providerTicketsAssigned    VisitorRequest[]      @relation("ProviderTicketAssignee")
  providerTicketsResubmitted VisitorRequest[]      @relation("ProviderTicketResubmittedBy")
  auditLogs                  CoordinatorAuditLog[]
  voiceLogs                  CoordinatorVoiceLog[]
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@map("coordinator_users")
}

model CoordinatorContact {
  id        String             @id @default(cuid())
  name      String // e.g. "أحمد" or "Ahmed" for lookup
  phone     String // E.164 e.g. +9647712345678
  companyId String
  company   CoordinatorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([companyId])
  @@index([companyId, name])
  @@map("coordinator_contacts")
}

model CoordinatorTask {
  id                   String                @id @default(cuid())
  title                String
  description          String?
  status               CoordinatorTaskStatus @default(PENDING)
  companyId            String
  company              CoordinatorCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById          String
  createdBy            CoordinatorUser       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  dueAt                DateTime?
  completedAt          DateTime?
  checklist            Json? // [{ "id": "uuid", "label": "...", "checked": bool }]
  fileUrls             String[]              @default([])
  source               String? // voice | email | whatsapp | manual
  coordinatorFeedback  String? // coordinator's feedback after action (e.g. "Called Ahmed, he said...")
  inboundReplyTo       String? // for inbound tasks: WhatsApp/email to send feedback to (e.g. whatsapp:+964...)
  awaitingFeedbackFrom String? // when we messaged a contact for this task: their whatsapp (e.g. whatsapp:+964...) so we link their reply
  aiProcessedAt        DateTime? // when AI last processed this task (status + WhatsApp reply)
  priority             String?               @default("normal") // normal | high | urgent (for escalation)
  subTasks             CoordinatorSubtask[]
  comments             CoordinatorComment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([dueAt])
  @@index([priority])
  @@map("coordinator_tasks")
}

model CoordinatorSubtask {
  id        String          @id @default(cuid())
  title     String
  done      Boolean         @default(false)
  taskId    String
  task      CoordinatorTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([taskId])
  @@map("coordinator_subtasks")
}

model CoordinatorComment {
  id        String          @id @default(cuid())
  body      String
  taskId    String
  task      CoordinatorTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String // CoordinatorUser id (optional relation to avoid circular)
  createdAt DateTime        @default(now())

  @@index([taskId])
  @@map("coordinator_comments")
}

model CoordinatorKPI {
  id          String             @id @default(cuid())
  name        String
  targetValue Float
  actualValue Float              @default(0)
  unit        String? // e.g. "%", "count"
  status      KPIStatus          @default(ON_TRACK)
  companyId   String
  company     CoordinatorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([companyId])
  @@map("coordinator_kpis")
}

model CoordinatorReport {
  id         String             @id @default(cuid())
  title      String
  type       String // daily | weekly | monthly | custom
  pdfUrl     String?
  companyId  String
  company    CoordinatorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodFrom DateTime
  periodTo   DateTime
  createdAt  DateTime           @default(now())

  @@index([companyId])
  @@map("coordinator_reports")
}

model CoordinatorExternalSystem {
  id         String                       @id @default(cuid())
  name       String
  type       ExternalSystemType
  configEnc  String? // AES-256 encrypted config (credentials, endpoints)
  companyId  String
  company    CoordinatorCompany           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actionLogs CoordinatorSystemActionLog[]
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  @@index([companyId])
  @@map("coordinator_external_systems")
}

model CoordinatorSystemActionLog {
  id           String                    @id @default(cuid())
  systemId     String
  system       CoordinatorExternalSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  action       String
  status       String // success | failure
  retryCount   Int                       @default(0)
  errorMessage String?
  payload      Json?
  createdAt    DateTime                  @default(now())

  @@index([systemId])
  @@map("coordinator_system_action_logs")
}

model CoordinatorSocialAccount {
  id        String                       @id @default(cuid())
  platform  String // linkedin | meta | whatsapp
  accountId String
  tokenEnc  String? // encrypted access token
  companyId String
  company   CoordinatorCompany           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages  CoordinatorOutreachMessage[]
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([companyId])
  @@map("coordinator_social_accounts")
}

model CoordinatorOutreachMessage {
  id        String                   @id @default(cuid())
  accountId String
  account   CoordinatorSocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipient String
  body      String
  sentAt    DateTime?
  replyAt   DateTime?
  taskId    String?
  createdAt DateTime                 @default(now())

  @@index([accountId])
  @@map("coordinator_outreach_messages")
}

model CoordinatorConversation {
  id        String   @id @default(cuid())
  channel   String // in_app | email | push
  threadId  String?
  createdAt DateTime @default(now())

  @@map("coordinator_conversations")
}

model CoordinatorSubscriptionPlan {
  id            String                    @id @default(cuid())
  tier          SubscriptionPlanTier      @unique
  name          String
  stripePriceId String?
  amountCents   Int
  interval      String // week | month | year
  companies     CoordinatorCompany[]
  subscriptions CoordinatorSubscription[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@map("coordinator_subscription_plans")
}

model CoordinatorSubscription {
  id               String                      @id @default(cuid())
  companyId        String
  company          CoordinatorCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId           String
  plan             CoordinatorSubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  stripeSubId      String?
  status           SubscriptionStatus          @default(ACTIVE)
  currentPeriodEnd DateTime?
  payments         CoordinatorPayment[]
  invoices         CoordinatorInvoice[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([companyId])
  @@map("coordinator_subscriptions")
}

model CoordinatorPayment {
  id                    String                  @id @default(cuid())
  subscriptionId        String
  subscription          CoordinatorSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String?
  amountCents           Int
  status                String
  createdAt             DateTime                @default(now())

  @@index([subscriptionId])
  @@map("coordinator_payments")
}

model CoordinatorInvoice {
  id             String                  @id @default(cuid())
  subscriptionId String
  subscription   CoordinatorSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  pdfUrl         String?
  amountCents    Int
  periodFrom     DateTime
  periodTo       DateTime
  createdAt      DateTime                @default(now())

  @@index([subscriptionId])
  @@map("coordinator_invoices")
}

model CoordinatorNotification {
  id        String   @id @default(cuid())
  userId    String // CoordinatorUser id
  title     String
  body      String?
  channel   String // in_app | email | push
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("coordinator_notifications")
}

model CoordinatorJobDutyTemplate {
  id           String             @id @default(cuid())
  name         String
  cron         String // e.g. "0 9 * * *" daily 9am
  frequency    String // daily | weekly | monthly | yearly
  companyId    String
  company      CoordinatorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskTemplate Json // { title, description, checklist }
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([companyId])
  @@map("coordinator_job_duty_templates")
}

model CoordinatorJobResult {
  id              String             @id @default(cuid())
  companyId       String
  company         CoordinatorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyword         String
  source          String?
  rawResult       Json?
  extractedSkills String[]           @default([])
  createdAt       DateTime           @default(now())

  @@index([companyId])
  @@map("coordinator_job_results")
}

model CoordinatorProfile {
  id        String          @id @default(cuid())
  userId    String          @unique
  user      CoordinatorUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills    String[]        @default([])
  cvUrl     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("coordinator_profiles")
}

model CoordinatorGeneratedApplication {
  id             String             @id @default(cuid())
  companyId      String
  company        CoordinatorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String?
  jobResultId    String?
  cvUrl          String?
  coverLetterUrl String?
  createdAt      DateTime           @default(now())

  @@index([companyId])
  @@map("coordinator_generated_applications")
}

model CoordinatorAuditLog {
  id         String             @id @default(cuid())
  companyId  String
  company    CoordinatorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       CoordinatorUser?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // login | task_create | task_update | system_action | payment_update | ...
  resource   String? // task | kpi | report | ...
  resourceId String?
  payload    Json?
  ip         String?
  createdAt  DateTime           @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("coordinator_audit_logs")
}

model CoordinatorVoiceLog {
  id               String          @id @default(cuid())
  userId           String
  user             CoordinatorUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript       String?
  detectedLanguage String?
  intent           String?
  actionTaken      String?
  audioFileUrl     String?
  createdAt        DateTime        @default(now())

  @@index([userId])
  @@map("coordinator_voice_logs")
}

model CoordinatorVoiceCallRecord {
  id         String             @id @default(cuid())
  direction  VoiceCallDirection
  duration   Int? // seconds
  transcript String?
  taskLinked String? // taskId if linked
  status     String
  companyId  String
  company    CoordinatorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@index([companyId])
  @@map("coordinator_voice_call_records")
}

// ═══════════════════════════════════════════════════════════════════════════
// Private Company Workspace (mobile-app feature)
// A COMPANY-role requester can request to open a private workspace; once an
// admin approves it the owner can create departments, assign staff, and build
// checklists. Staff see only their company's tickets and notifications.
// ═══════════════════════════════════════════════════════════════════════════

enum PrivateCompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model PrivateCompany {
  id               String                     @id @default(cuid())
  name             String
  description      String?
  logoUrl          String?
  ownerRequesterId String                     @unique
  owner            TicketRequester            @relation("PrivateCompanyOwner", fields: [ownerRequesterId], references: [id], onDelete: Cascade)
  status           PrivateCompanyStatus       @default(PENDING)
  rejectionReason  String?
  approvedAt       DateTime?
  approvedById     String? // admin User id (web admin)
  departments      PrivateCompanyDepartment[]
  staff            TicketRequester[]          @relation("PrivateCompanyStaff")
  checklists       PrivateCompanyChecklist[]
  scopedTickets    VisitorRequest[]           @relation("PrivateCompanyScopedTickets")
  materials        PrivateCompanyMaterial[]         @relation("PrivateCompanyMaterials")
  materialItems    PrivateCompanyMaterialItem[]    @relation("PrivateCompanyMaterialItems")
  materialMovements PrivateCompanyMaterialMovement[] @relation("PrivateCompanyMaterialMovements")
  materialRequests PrivateCompanyMaterialRequest[]  @relation("PrivateCompanyMaterialRequests")
  staffMaterialBudgets PrivateCompanyStaffMaterialBudget[] @relation("PrivateCompanyStaffMaterialBudgets")
  /// Optional QC / maintenance technique slugs for this workspace (owner-managed).
  workspaceTechniques PrivateCompanyTechnique[]
  /// Preset labels for material USE / DAMAGE / LOST movement notes (owner, manager, coordinator).
  materialUseReasons String[] @default([])
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([status])
  @@map("private_companies")
}

/// Workspace-specific ticket technique options (slug stored on VisitorRequest.technique).
/// Optional [departmentId] limits visibility to that department; null = all members.
model PrivateCompanyTechnique {
  id           String                    @id @default(cuid())
  companyId    String
  company      PrivateCompany            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     String // INSPECTION_QC | MAINTENANCE
  slug         String
  labelAr      String
  labelEn      String?
  sortOrder    Int                       @default(0)
  active       Boolean                   @default(true)
  departmentId String?
  department   PrivateCompanyDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([companyId, category, slug])
  @@index([companyId, active])
  @@index([departmentId])
  @@map("private_company_techniques")
}

model PrivateCompanyDepartment {
  id          String            @id @default(cuid())
  companyId   String
  company     PrivateCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String? // hex color for UI accent
  iconKey     String? // material icon key for UI
  sortOrder   Int               @default(0)
  /// Owner: allow technicians on this department to join the same maintenance ticket when in proximity.
  maintenanceProximityJoinEnabled Boolean @default(false)
  /// Default pairing radius in meters (technicians); staff may override individually.
  maintenanceProximityRadiusM     Int     @default(100)
  /// Owner: engineers in this department may browse and self-assign from the pending QC pool (workspace tickets).
  engineerAvailabilityPoolEnabled   Boolean @default(true)
  /// Owner: technicians may self-assign pending maintenance from the pool (when ticket targets this department).
  technicianAvailabilityPoolEnabled Boolean @default(true)
  /// DIRECT_TECHNICIAN = pending maintenance goes to technician pool. ENGINEER_ASSIGNS = engineers/managers/coordinators assign a technician first (same department + ticket province rules as staff).
  maintenanceDispatchMode           String  @default("DIRECT_TECHNICIAN")
  members     TicketRequester[] @relation("PrivateCompanyDepartmentMember")
  techniques  PrivateCompanyTechnique[]
  workspaceTargetedTickets VisitorRequest[] @relation("WorkspaceTicketTargetDepartment")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("private_company_departments")
}

model PrivateCompanyChecklist {
  id             String                @id @default(cuid())
  companyId      String
  company        PrivateCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  category       ProviderTaskCategory?
  techniqueTypes String[]              @default([])
  items          Json // [{ id, label, weight?, required? }]
  createdById    String
  createdBy      TicketRequester       @relation("PrivateCompanyChecklistCreator", fields: [createdById], references: [id], onDelete: Cascade)
  departmentId   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([companyId])
  @@index([departmentId])
  @@map("private_company_checklists")
}

// ─────────────────────────────────────────────────────────────────────────────
// Private company warehouse: track materials, serial-numbered inventory,
// assignments to staff, and consumption on tickets — all scoped to one
// private workspace.
// ─────────────────────────────────────────────────────────────────────────────

enum PrivateCompanyMaterialTracking {
  SERIAL // each unit has a unique serial number
  BULK   // tracked only by quantity (cable on a reel, screws, etc.)
}

enum PrivateCompanyMaterialItemStatus {
  IN_WAREHOUSE
  ASSIGNED // currently held by a staff member
  USED     // consumed on a ticket
  DAMAGED
  LOST
  RETIRED
}

enum PrivateCompanyMaterialMovementType {
  STOCKED     // added to warehouse
  ASSIGNED    // given to a staff member
  RETURNED    // staff returned it to warehouse
  USED        // consumed on a ticket
  TRANSFERRED // staff -> staff
  DAMAGED
  LOST
  ADJUSTED    // metadata/status edit
  HANDOVER_CONFIRMED // assignee confirmed physical receipt from warehouse
  HANDOVER_REJECTED  // assignee rejected assignment (with reason)
  RETURN_REQUESTED   // keeper/owner asked assignee to approve return
  RETURN_REJECTED    // assignee rejected keeper return request (with reason)
}

enum PrivateCompanyMaterialRequestKind {
  INVENTORY_MATERIAL // catalog material (may still be out of stock)
  CUSTOM_UNAVAILABLE // not in catalog — describe what is needed
}

enum PrivateCompanyMaterialRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  AWAITING_RECEIPT // keeper dispatched; requester must confirm receipt
  FULFILLED
  CANCELLED
}

model PrivateCompanyMaterial {
  id          String                          @id @default(cuid())
  companyId   String
  company     PrivateCompany                  @relation("PrivateCompanyMaterials", fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String? // free-form ("Cable", "Tool", "Spare part")
  unit        String? // "pcs", "m", "kg", "set"
  iconKey     String? // material icon key (UI)
  color       String? // accent hex (UI)
  tracking    PrivateCompanyMaterialTracking  @default(SERIAL)
  createdById String?
  createdBy   TicketRequester?                @relation("PrivateCompanyMaterialCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items       PrivateCompanyMaterialItem[]
  requests    PrivateCompanyMaterialRequest[] @relation("PrivateCompanyMaterialRequestMaterial")
  staffBudgets PrivateCompanyStaffMaterialBudget[] @relation("StaffBudgetMaterial")
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("private_company_materials")
}

/// Per-staff cap on how many units of a catalog material they may hold in
/// ASSIGNED status at once (workspace managers set budgets; keepers enforce on assign).
model PrivateCompanyStaffMaterialBudget {
  id               String   @id @default(cuid())
  companyId        String
  company          PrivateCompany @relation("PrivateCompanyStaffMaterialBudgets", fields: [companyId], references: [id], onDelete: Cascade)
  staffRequesterId String
  staff            TicketRequester @relation("StaffMaterialBudget", fields: [staffRequesterId], references: [id], onDelete: Cascade)
  materialId       String
  material         PrivateCompanyMaterial @relation("StaffBudgetMaterial", fields: [materialId], references: [id], onDelete: Cascade)
  budgetQuantity   Int
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, staffRequesterId, materialId])
  @@index([companyId, staffRequesterId])
  @@map("private_company_staff_material_budgets")
}

model PrivateCompanyMaterialItem {
  id           String                            @id @default(cuid())
  companyId    String
  company      PrivateCompany                    @relation("PrivateCompanyMaterialItems", fields: [companyId], references: [id], onDelete: Cascade)
  materialId   String
  material     PrivateCompanyMaterial            @relation(fields: [materialId], references: [id], onDelete: Cascade)
  serialNumber String // unique within the workspace; for BULK use a generated lot/SKU code
  province     String // Iraq governorate where the unit physically lives
  status       PrivateCompanyMaterialItemStatus  @default(IN_WAREHOUSE)
  quantity     Int                               @default(1) // > 1 only for BULK materials
  notes        String?
  assignedToId String?
  assignedTo   TicketRequester?                  @relation("PrivateCompanyMaterialItemAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  usedTicketId String?
  usedTicket   VisitorRequest?                   @relation("PrivateCompanyMaterialItemUsedTicket", fields: [usedTicketId], references: [id], onDelete: SetNull)
  usedAt       DateTime?
  createdById  String?
  createdBy    TicketRequester?                  @relation("PrivateCompanyMaterialItemStocker", fields: [createdById], references: [id], onDelete: SetNull)
  handoverConfirmedAt   DateTime?
  handoverConfirmedById String?
  handoverConfirmedBy   TicketRequester?                  @relation("MaterialHandoverConfirmedBy", fields: [handoverConfirmedById], references: [id], onDelete: SetNull)
  handoverRejectedAt    DateTime?
  handoverRejectionReason String?
  returnRequestedAt     DateTime?
  returnRequestedById   String?
  returnRequestedBy     TicketRequester?                  @relation("MaterialReturnRequestedBy", fields: [returnRequestedById], references: [id], onDelete: SetNull)
  returnRequestNote     String?
  returnRejectedAt      DateTime?
  returnRejectionReason String?
  movements    PrivateCompanyMaterialMovement[]
  createdAt    DateTime                          @default(now())
  updatedAt    DateTime                          @updatedAt

  @@unique([companyId, serialNumber])
  @@index([companyId, status])
  @@index([companyId, province])
  @@index([materialId])
  @@index([assignedToId])
  @@index([usedTicketId])
  @@index([handoverConfirmedById])
  @@index([returnRequestedById])
  @@map("private_company_material_items")
}

model PrivateCompanyMaterialMovement {
  id          String                              @id @default(cuid())
  companyId   String
  company     PrivateCompany                      @relation("PrivateCompanyMaterialMovements", fields: [companyId], references: [id], onDelete: Cascade)
  itemId      String
  item        PrivateCompanyMaterialItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        PrivateCompanyMaterialMovementType
  fromStaffId String?
  fromStaff   TicketRequester?                    @relation("PrivateCompanyMaterialMovementFrom", fields: [fromStaffId], references: [id], onDelete: SetNull)
  toStaffId   String?
  toStaff     TicketRequester?                    @relation("PrivateCompanyMaterialMovementTo", fields: [toStaffId], references: [id], onDelete: SetNull)
  ticketId    String?
  ticket      VisitorRequest?                     @relation("PrivateCompanyMaterialMovementTicket", fields: [ticketId], references: [id], onDelete: SetNull)
  quantity    Int                                 @default(1)
  note        String?
  actorId     String
  actor       TicketRequester                     @relation("PrivateCompanyMaterialMovementActor", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt   DateTime                            @default(now())

  @@index([companyId, createdAt])
  @@index([itemId])
  @@index([ticketId])
  @@map("private_company_material_movements")
}

/// Staff-submitted material need (in-catalog or custom). Warehouse keepers respond.
model PrivateCompanyMaterialRequest {
  id                 String                            @id @default(cuid())
  companyId          String
  company            PrivateCompany                    @relation("PrivateCompanyMaterialRequests", fields: [companyId], references: [id], onDelete: Cascade)
  requesterId        String
  requester          TicketRequester                   @relation("MaterialRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  kind               PrivateCompanyMaterialRequestKind
  materialId       String?
  material           PrivateCompanyMaterial?           @relation("PrivateCompanyMaterialRequestMaterial", fields: [materialId], references: [id], onDelete: SetNull)
  customTitle        String?
  customDescription  String?
  quantity           Int                               @default(1)
  province           String?
  notes              String?
  status             PrivateCompanyMaterialRequestStatus @default(PENDING)
  responderId        String?
  responder          TicketRequester?                  @relation("MaterialRequestResponder", fields: [responderId], references: [id], onDelete: SetNull)
  responseNote       String?
  fulfilledItemId    String? // optional unit id the keeper linked when fulfilling
  receivedAt         DateTime? // set when requester confirms receipt
  receivedNote       String?
  notReceivedAt      DateTime?
  notReceivedNote    String?
  receiptIssueAcknowledgedAt   DateTime?
  receiptIssueAcknowledgedById String?
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@index([companyId, status])
  @@index([requesterId])
  @@index([materialId])
  @@map("private_company_material_requests")
}
