<?xml version="1.0" encoding="utf-8"?>
<!-- Provisor native splash — matches Flutter splash base -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF04060F" />
        </shape>
    </item>
    <item android:gravity="center" android:width="120dp" android:height="120dp">
        <bitmap android:src="@drawable/provisor_logo" android:gravity="fill" />
    </item>
</layer-list>
