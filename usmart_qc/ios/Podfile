platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# iCloud/Desktop sync can evict CocoaPods `.lproj` bundles after install, breaking Archive.
def restore_pod_resources_if_missing(pod_name, relative_resources_path)
  require 'fileutils'

  dest_resources = File.expand_path(
    File.join('Pods', pod_name, relative_resources_path),
    __dir__,
  )
  return unless File.directory?(dest_resources)

  missing = Dir.glob(File.join(dest_resources, '*')).empty? ||
            Dir.glob(File.join(dest_resources, '*.lproj')).empty?
  return unless missing

  cache_root = File.expand_path(
    File.join('~/Library/Caches/CocoaPods/Pods/Release', pod_name),
  )
  return unless File.directory?(cache_root)

  cache_versions = Dir.glob(File.join(cache_root, '*'))
                      .select { |path| File.directory?(path) }
                      .sort
  return if cache_versions.empty?

  src_resources = File.join(cache_versions.last, relative_resources_path)
  return unless File.directory?(src_resources)

  restored = 0
  Dir.glob(File.join(src_resources, '*')).each do |entry|
    target = File.join(dest_resources, File.basename(entry))
    next if File.exist?(target)

    FileUtils.cp_r(entry, dest_resources)
    restored += 1
  end

  puts "Restored #{restored} missing #{pod_name} resource(s) from CocoaPods cache" if restored.positive?
end

target 'Runner' do
  # Static linkage avoids missing GoogleDataTransport/Firebase headers with dynamic frameworks.
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
    end
  end

  restore_pod_resources_if_missing(
    'DKImagePickerController',
    'Sources/DKImagePickerController/Resource/Resources',
  )
  restore_pod_resources_if_missing(
    'DKPhotoGallery',
    'DKPhotoGallery/Resource/Resources',
  )
end
